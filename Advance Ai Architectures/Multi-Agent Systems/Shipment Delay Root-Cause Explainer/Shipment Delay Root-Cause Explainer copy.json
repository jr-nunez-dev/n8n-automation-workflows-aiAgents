    {
      "parameters": {
        "promptType": "define",
        "text": "=Shipment Information\n\nShipment ID:\n{{$json.shipment_id}}\n\nOrigin:\n{{$json.origin}}\n\nDestination:\n{{$json.destination}}\n\nCarrier:\n{{$json.carrier}}\n\nDelay Hours:\n{{$json.delay_hours}}\n\nWeather:\n{{$json.weather}}\n\nCustoms:\n{{$json.customs}}\n\nInventory Issue:\n{{$json.inventory_issue}}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a logistics analyst.\n\nAnalyze the shipment information.\n\nDetermine:\n\n1. Primary root cause.\n2. Identify all contributing factors.\n3. Assign each factor a percentage weight.\n4. The weights must total exactly 100%.\n5. Estimate confidence (0-100).\n6. Explain the delay.\n7. Recommend the next action.\n8. Classify urgency.\n\n\nReturn ONLY valid JSON.\n\nExample:\n\n{\n  \"shipment_id\": \"SHP-1001\",\n  \"root_cause\": \"Weather Delay\",\n  \"contributing_factors\": [\n    {\n      \"factor\": \"Weather\",\n      \"weight\": 70\n    },\n    {\n      \"factor\": \"Customs\",\n      \"weight\": 30\n    }\n  ],\n  \"confidence\": 94,\n  \"explanation\": \"Heavy storms delayed vessel departure and customs inspection added additional waiting time.\",\n  \"recommended_action\": \"Notify customer and escalate with the carrier.\",\n  \"urgency\": \"High\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        0
      ],
      "id": "204b134f-a623-4d7e-87bc-7a0c6366c3fc",
      "name": "logistics analyst"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate today's executive logistics report.\n\nUse ONLY the statistics below.\n\n{{ JSON.stringify($input.first().json, null, 2) }}\n\nDo not invent numbers.\n\nWrite a professional manager briefing.\n\nReturn valid JSON only.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a Senior Logistics Operations Manager.\n\nYou will receive logistics KPIs and shipment reports.\n\nWrite:\n\n1. Manager briefing\n2. Executive summary\n3. Operational trends\n4. Top recommendations\n5. Next 24-hour priorities\n\nDo not calculate statistics.\nUse the KPIs provided.\nReturn valid JSON only."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2240,
        0
      ],
      "id": "54b8bc75-a789-471a-b6f8-e91fe9591db3",
      "name": "Senior Logistics Operations Manager"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "shipment",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1840,
        0
      ],
      "id": "ca82ee6a-d814-4c1c-8288-2bae9468c4d6",
      "name": "compressData"
    },
    {
      "parameters": {
        "jsCode": "// Get the shipment array from the Aggregate/Compress node\nconst shipments = items[0].json.shipment || [];\n\nconst total = shipments.length;\n\nconst high = shipments.filter(s => s.urgency === \"High\").length;\nconst medium = shipments.filter(s => s.urgency === \"Medium\").length;\nconst low = shipments.filter(s => s.urgency === \"Low\").length;\n\n// Average confidence\nconst avgConfidence =\n    total > 0\n        ? shipments.reduce((sum, s) => sum + (s.confidence || 0), 0) / total\n        : 0;\n\n// Count root causes\nconst rootCauses = {};\n\n// Sum contributing factor weights\nconst factors = {};\n\nfor (const shipment of shipments) {\n\n    if (shipment.root_cause) {\n        rootCauses[shipment.root_cause] =\n            (rootCauses[shipment.root_cause] || 0) + 1;\n    }\n\n    if (Array.isArray(shipment.contributing_factors)) {\n\n        for (const factor of shipment.contributing_factors) {\n\n            factors[factor.factor] =\n                (factors[factor.factor] || 0) + factor.weight;\n\n        }\n\n    }\n\n}\n\n// Sort root causes\nconst sortedRootCauses = Object.entries(rootCauses)\n    .sort((a, b) => b[1] - a[1]);\n\n// Sort contributing factors\nconst sortedFactors = Object.entries(factors)\n    .sort((a, b) => b[1] - a[1]);\n\nconst topRootCause =\n    sortedRootCauses.length > 0\n        ? sortedRootCauses[0][0]\n        : \"None\";\n\nconst topFactor =\n    sortedFactors.length > 0\n        ? sortedFactors[0][0]\n        : \"None\";\n\n// Highest risk shipments\nconst highestRisk = shipments\n    .filter(s => s.urgency === \"High\")\n    .map(s => s.shipment_id);\n\n// Return one item\nreturn [\n    {\n        json: {\n\n            total_shipments: total,\n\n            urgency_breakdown: {\n                high,\n                medium,\n                low\n            },\n\n            average_confidence: Number(avgConfidence.toFixed(1)),\n\n            top_root_cause: topRootCause,\n\n            top_contributing_factor: topFactor,\n\n            highest_risk_shipments: highestRisk,\n\n            shipment_reports: shipments\n\n        }\n    }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        0
      ],
      "id": "42295258-75ec-4eb9-b5e8-f7eeaf991ca8",
      "name": "parseData"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"report_date\": \"2026-07-26\",\n  \"total_shipments\": 10,\n  \"shipment_breakdown\": {\n    \"high_urgency\": 3,\n    \"medium_urgency\": 7,\n    \"low_urgency\": 0\n  },\n  \"kpis\": {\n    \"average_confidence\": 91,\n    \"high_risk_percentage\": 30,\n    \"weather_related_percentage\": 40,\n    \"customs_related_percentage\": 20,\n    \"inventory_related_percentage\": 30,\n    \"carrier_related_percentage\": 10\n  },\n  \"top_delay_causes\": [\n    {\n      \"cause\": \"Weather Delay\",\n      \"count\": 4\n    },\n    {\n      \"cause\": \"Inventory Issue\",\n      \"count\": 3\n    }\n  ],\n  \"highest_risk_shipments\": [\n    {\n      \"shipment_id\": \"SHP-1003\",\n      \"urgency\": \"High\",\n      \"root_cause\": \"Inventory Issue\",\n      \"confidence\": 95\n    }\n  ],\n  \"operational_trends\": [\n    \"Weather remains the leading cause of delays.\",\n    \"Inventory issues have increased this week.\"\n  ],\n  \"recommended_actions\": [\n    \"Notify affected customers.\",\n    \"Coordinate with carriers.\",\n    \"Monitor weather forecasts.\"\n  ],\n  \"manager_briefing\": \"Operations remained stable despite several weather-related disruptions.\",\n  \"executive_summary\": \"Ten shipments were processed today with three high urgency cases.\",\n  \"next_24_hour_priorities\": [\n    \"Monitor high-risk shipments.\",\n    \"Follow up with carriers.\",\n    \"Review inventory bottlenecks.\"\n  ]\n}"
      },

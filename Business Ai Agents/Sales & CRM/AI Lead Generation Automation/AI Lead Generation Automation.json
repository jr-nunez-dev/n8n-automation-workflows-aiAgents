      "parameters": {
        "jsCode": "// Extract all company names dynamically from the input array\nconst companies = $input.all().map(item => item.json.Company);\nconst leadCount = companies.length;\n\n// Format company list dynamically into bullet points\nconst companyListText = companies.map(name => `• ${name}`).join('\\n');\n\n// Generate dynamic subject line and body\nconst dynamicSubject = `🚀 New Leads Alert: ${leadCount} fresh prospect${leadCount === 1 ? '' : 's'} ready!`;\n\nconst emailBody = `Hey Team,\n\nHope you're having a great day! \n\nOur automated pipeline just pulled in ${leadCount} fresh prospect${leadCount === 1 ? '' : 's'}. Here are the latest companies added to our pipeline:\n\n${companyListText}\n\nAll contact details, custom icebreakers, and review stats are ready in the main dataset. Feel free to jump in and start outreach whenever you're set!\n\nBest,\nAutomation Team`;\n\n// Return a single object with separated fields for easy n8n mapping\nreturn [{\n  json: {\n    emailSubject: dynamicSubject,\n    generatedEmail: emailBody\n  }\n}];"
      },

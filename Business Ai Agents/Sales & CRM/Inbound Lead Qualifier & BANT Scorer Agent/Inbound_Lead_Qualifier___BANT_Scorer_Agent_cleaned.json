    {
      "parameters": {
        "jsCode": "const zone = 'Asia/Manila';\nconst events = $input.all().map(item => item.json);\nconst workStart = 9;\nconst workEnd = 17;\nconst slotMinutes = 30;\n\nconst busy = events.map(e => ({\n  start: DateTime.fromISO(e.start.dateTime || e.start.date, { zone }),\n  end: DateTime.fromISO(e.end.dateTime || e.end.date, { zone })\n}));\n\nlet candidate = DateTime.now().setZone(zone).plus({ minutes: 60 }).set({ second: 0, millisecond: 0 });\ncandidate = candidate.minute < 30\n  ? candidate.set({ minute: 30 })\n  : candidate.set({ minute: 0 }).plus({ hours: 1 });\n\nfunction overlaps(start, end) {\n  return busy.some(b => start < b.end && end > b.start);\n}\n\nlet found = null;\nfor (let i = 0; i < 200; i++) {\n  const hour = candidate.hour;\n  const day = candidate.weekday; // 1=Mon ... 7=Sun in Luxon\n  if (day <= 5 && hour >= workStart && hour < workEnd) {\n    const slotEnd = candidate.plus({ minutes: slotMinutes });\n    if (!overlaps(candidate, slotEnd)) {\n      found = { start: candidate, end: slotEnd };\n      break;\n    }\n  }\n  candidate = candidate.plus({ minutes: slotMinutes });\n}\n\nif (!found) throw new Error('No open slot found in the next 3 business days');\n\nreturn {\n  json: {\n    ...$('Route Tier').first().json, // match your actual node name\n    slot_start: found.start.toISO(),\n    slot_end: found.end.toISO()\n  }\n};"
      },

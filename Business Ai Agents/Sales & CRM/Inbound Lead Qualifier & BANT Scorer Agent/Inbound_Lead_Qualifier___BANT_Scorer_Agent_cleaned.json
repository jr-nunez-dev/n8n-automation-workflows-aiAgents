        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a BANT lead scoring engine. Score the lead below on four dimensions, each 0-25.  \n\nBudget: signals of financial capacity or willingness to spend (mentioned budget, company size, funding stage) \nAuthority: does this person have decision-making power (title, \"I can approve\", \"I'd need to check with...\") \nNeed: how clearly they describe a real problem you solve, and urgency of that problem \nTimeline: how soon they want to act (specific date = high, \"someday\"/\"exploring\" = low)  \n\nLead message: {{ $json.message }} \nCompany info: {{ $json.employees }} employees, {{ $json.industry }}, {{ $json.funding_stage }}  \n\nReturn ONLY valid JSON, no markdown, no commentary, in exactly this shape: {\"budget\": <0-25>, \"authority\": <0-25>, \"need\": <0-25>, \"timeline\": <0-25>, \"total\": <sum>, \"tier\": \"Hot|Warm|Cold\", \"reasoning\": \"<1-2 sentences>\"}  Tier rule: total >= 70 = Hot, 40-69 = Warm, below 40 = Cold."
            }
          ]
        },
        "batching": {}
      },

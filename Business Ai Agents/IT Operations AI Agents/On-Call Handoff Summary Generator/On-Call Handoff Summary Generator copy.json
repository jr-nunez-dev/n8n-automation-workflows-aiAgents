    {
      "parameters": {
        "promptType": "define",
        "text": "=Shift:  {{ $json.shift }}\nEngineer: {{ $json.engineer }}\n\nIncidents: {{ $json.incidents }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an on-call handoff assistant. Given a shift's incident log, produce a structured handoff summary for the next on-call engineer. \n\nInclude:  \nShift overview (time range, engineer, total incidents by severity) \n\"What happened\" — brief narrative per incident, oldest to newest \n\"Still smoldering\" — anything unresolved or being watched, with what to keep an eye on \n\"Risk level for next shift\" — one of: Chill / Watch Closely / Buckle Up, with a one-line justification  \n\nBase the risk level on: number and severity of unresolved/watching items, whether any P1/P2 recurred, and whether root causes were actually fixed vs. band-aided. \nOutput clean Markdown, no fluff.\n\nNOTE: ALWAYS OUTPUT IN JSON"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        144,
        0
      ],
      "id": "ccb92632-71d0-43d9-8bb1-18f0f9fb437e",
      "name": "Basic LLM Chain"
    },
